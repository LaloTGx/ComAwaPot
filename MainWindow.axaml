<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComAwaPot.ViewModels"
        xmlns:views="using:ComAwaPot.Views"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        x:Class="ComAwaPot.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ComAwaPot"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600">

    <Window.Styles>

        <Style Selector="Button.menu-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="Button.menu-button:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </Window.Styles>


    <Window.DataTemplates>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PersonasViewModel}">
            <views:PersonasView />
        </DataTemplate>

        <DataTemplate DataType="vm:NewPersonaViewModel">
            <views:NewPersonaView/>
        </DataTemplate>

        <DataTemplate DataType="vm:PersonaDetalleViewModel">
            <views:PersonaDetalleView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TomasViewModel}">
            <views:TomasView/>
        </DataTemplate>

        <DataTemplate DataType="vm:NewTomaViewModel">
            <views:NewTomaView />
        </DataTemplate>

        <DataTemplate DataType="vm:TomaDetalleViewModel">
            <views:TomaDetalleView />
        </DataTemplate>

    </Window.DataTemplates>


    <!-- Contenedor raíz -->

    <Grid>

        <!-- Aplicación principal -->

        <Grid ColumnDefinitions="220,*">

            <!-- Menú lateral -->

            <Border Grid.Column="0"
                    Background="#18181B">

                <Grid RowDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Row="0"
                                Margin="24,28,24,32"
                                Spacing="4">

                        <TextBlock Text="ComAwaPot"
                                   FontSize="24"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Comité de agua potable"
                                   FontSize="13"
                                   Opacity="0.6"/>

                    </StackPanel>


                    <StackPanel Grid.Row="1"
                                Margin="12,0"
                                Spacing="5"
                                VerticalAlignment="Center">

                        <Button Classes="menu-button"
                                Content="Inicio"
                                Command="{Binding MostrarInicioCommand}"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Personas"
                                Command="{Binding MostrarPersonasCommand}"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Tomas"
                                Command="{Binding MostrarTomasCommand}"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Tarifas"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Pagos"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Aportaciones"/>

                        <Separator/>

                        <Button Classes="menu-button"
                                Content="Reportes"/>

                    </StackPanel>


                    <TextBlock Grid.Row="2"
                               Text="ComAwaPot 1.0.0"
                               Margin="24,24"
                               FontSize="12"
                               Opacity="0.5"/>

                </Grid>

            </Border>


            <!-- Contenido principal -->

            <Border Grid.Column="1"
                    Padding="40">

                <ContentControl Content="{Binding CurrentViewModel}"/>

            </Border>

        </Grid>


        <!-- Overlay -->

        <Grid IsVisible="{Binding MostrarNuevaPersona}">

            <!-- Fondo oscuro -->

            <Border Background="#80000000"
                    PointerPressed="CerrarNuevaPersona_Click"/>


            <!-- Modal -->

            <Border Width="700"
                    MaxHeight="620"
                    Background="#18181B"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32">

                <views:NewPersonaView
                    DataContext="{Binding NewPersonaViewModel}"/>

            </Border>

        </Grid>

    </Grid>

</Window>
