<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComAwaPot.ViewModels"
        xmlns:views="using:ComAwaPot.Views"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        x:Class="ComAwaPot.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ComAwaPot"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600">

    <Window.DataTemplates>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PersonasViewModel}">
            <views:PersonasView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TomasViewModel}">
            <views:TomasView/>
        </DataTemplate>

    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*">

        <!-- Navegación -->
        <Border Grid.Column="0"
                Background="#18181B">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                            Margin="24,28,24,32"
                            Spacing="4">

                    <TextBlock Text="ComAwaPot"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Comité de agua"
                               FontSize="13"
                               Opacity="0.6"/>
                </StackPanel>

                <!-- Menú -->
                <StackPanel Grid.Row="1"
                            Margin="12,0"
                            Spacing="4">

                    <Button Content="Inicio"
                            Command="{Binding MostrarInicioCommand}"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Personas"
                            Command="{Binding MostrarPersonasCommand}"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Tomas"
                            Command="{Binding MostrarTomasCommand}"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Tarifas"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Pagos"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Aportaciones"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                    <Button Content="Reportes"
                            HorizontalContentAlignment="Left"
                            Padding="16,12"/>

                </StackPanel>

                <!-- Pie -->
                <TextBlock Grid.Row="2"
                           Text="ComAwaPot"
                           Margin="24,24"
                           FontSize="12"
                           Opacity="0.5"/>

            </Grid>

        </Border>

        <!-- Contenido -->
        <Border Grid.Column="1"
                Padding="40">

            <ContentControl Content="{Binding CurrentViewModel}"/>

        </Border>

    </Grid>

</Window>
