<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ComAwaPot.ViewModels"
             x:Class="ComAwaPot.Views.TomasView"
             x:DataType="vm:TomasViewModel">

    <UserControl.Styles>

        <Style Selector="Button.table-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="Button.table-button:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="24">

        <!-- Encabezado -->
        <Grid Grid.Row="0">

            <StackPanel Spacing="4">

                <TextBlock Text="Tomas"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Administra las tomas registradas en el comité."
                           FontSize="16"
                           Opacity="0.7"/>

            </StackPanel>

        </Grid>

        <!-- Búsqueda -->
        <TextBox Grid.Row="1"
                 PlaceholderText="Buscar por contrato, persona o calle..."
                 Text="{Binding TextoBusqueda}"/>

        <!-- Lista -->
        <Border Grid.Row="2"
                Background="#18181B"
                CornerRadius="8"
                Padding="16">

            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12">

			<!-- Encabezados -->
			<Grid Grid.Row="0"
			      ColumnDefinitions="100,*,*,100"
			      Margin="12,0">

			    <TextBlock Grid.Column="0"
			               Text="Contrato"
			               FontWeight="Bold"
			               Opacity="0.7"/>

			    <TextBlock Grid.Column="1"
			               Text="Persona"
			               FontWeight="Bold"
			               Opacity="0.7"/>

			    <TextBlock Grid.Column="2"
			               Text="Dirección"
			               FontWeight="Bold"
			               Opacity="0.7"/>

			    <TextBlock Grid.Column="3"
			               Text="Estado"
			               FontWeight="Bold"
			               Opacity="0.7"
			               HorizontalAlignment="Center"/>

			</Grid>

                <!-- Tomas -->
                <ScrollViewer Grid.Row="1">

                    <ItemsControl ItemsSource="{Binding TomasFiltradas}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Classes="table-button"
                                        Command="{Binding $parent[ItemsControl].DataContext.SeleccionarTomaCommand}"
                                        CommandParameter="{Binding}">

                                    <Grid ColumnDefinitions="100,*,*,100">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding NumeroContrato}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Persona.NombreCompleto}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Calle}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Estado}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Button>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>
