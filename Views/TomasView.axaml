<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ComAwaPot.ViewModels"
             x:Class="ComAwaPot.Views.TomasView"
             x:DataType="vm:TomasViewModel">

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="24">

        <!-- Encabezado -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">

            <StackPanel Grid.Column="0"
                        Spacing="4">

                <TextBlock Text="Tomas"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Administra las tomas registradas en el comité."
                           FontSize="16"
                           Opacity="0.7"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Nueva toma"
                    Padding="18,10"/>

        </Grid>

        <!-- Búsqueda -->
        <TextBox Grid.Row="1"
                 PlaceholderText="Buscar por contrato, persona o calle..."
                 Text="{Binding TextoBusqueda}"/>

        <!-- Lista + detalle -->
        <Grid Grid.Row="2"
              ColumnDefinitions="2*,*"
              ColumnSpacing="24">

            <!-- Lista -->
            <Border Grid.Column="0"
                    Background="#18181B"
                    CornerRadius="8"
                    Padding="16">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12">

                    <!-- Encabezados -->
                    <Grid Grid.Row="0"
                          ColumnDefinitions="100,*,*,100">

                        <TextBlock Grid.Column="0"
                                   Text="Contrato"
                                   FontWeight="Bold"
                                   Opacity="0.7"/>

                        <TextBlock Grid.Column="1"
                                   Text="Persona"
                                   FontWeight="Bold"
                                   Opacity="0.7"/>

                        <TextBlock Grid.Column="2"
                                   Text="Dirección"
                                   FontWeight="Bold"
                                   Opacity="0.7"/>

                        <TextBlock Grid.Column="3"
                                   Text="Estado"
                                   FontWeight="Bold"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"/>

                    </Grid>

                    <!-- Tomas -->
                    <ScrollViewer Grid.Row="1">

                        <ItemsControl ItemsSource="{Binding TomasFiltradas}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button HorizontalContentAlignment="Stretch"
                                            Padding="12"
                                            Margin="0,0,0,4"
                                            Command="{Binding $parent[ItemsControl].DataContext.SeleccionarTomaCommand}"
                                            CommandParameter="{Binding}">

                                        <Grid ColumnDefinitions="100,*,*,100">

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding NumeroContrato}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Persona.Nombre}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Calle}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Estado}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- Detalle -->
            <Border Grid.Column="1"
                    Background="#18181B"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="Información"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Toma seleccionada"
                               FontSize="13"
                               Opacity="0.6"/>

                    <TextBlock Text="{Binding TomaSeleccionada.NumeroContrato,
                                              StringFormat='Contrato: {0}'}"/>

                    <TextBlock Text="{Binding TomaSeleccionada.Persona.Nombre,
                                              StringFormat='Persona: {0}'}"/>

                    <TextBlock Text="{Binding TomaSeleccionada.Calle,
                                              StringFormat='Calle: {0}'}"/>

                    <TextBlock Text="{Binding TomaSeleccionada.NumExt,
                                              StringFormat='Número exterior: {0}'}"/>

                    <TextBlock Text="{Binding TomaSeleccionada.Estado,
                                              StringFormat='Estado: {0}'}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
