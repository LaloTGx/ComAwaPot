<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ComAwaPot.ViewModels"
             x:Class="ComAwaPot.Views.PersonasView"
             x:DataType="vm:PersonasViewModel">

    <UserControl.Styles>

        <Style Selector="Button.table-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="Button.table-button:pointerover">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="24">

        <!-- Encabezado -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">

            <StackPanel Grid.Column="0"
                        Spacing="4">

                <TextBlock Text="Personas"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="Administra las personas registradas en el comité."
                           FontSize="16"
                           Opacity="0.7"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Nueva persona"
                    Command="{Binding NuevaPersonaCommand}"
                    Padding="18,10"/>

        </Grid>

        <!-- Búsqueda -->
        <TextBox Grid.Row="1"
                 PlaceholderText="Buscar por nombre o apellido..."
                 Text="{Binding TextoBusqueda}"/>

        <!-- Lista -->
        <Border Grid.Row="2"
                Background="#18181B"
                CornerRadius="8"
                Padding="16">

            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12">

                <!-- Encabezados -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,120"
                      Margin="12,0">

                    <TextBlock Grid.Column="0"
                               Text="Nombre completo"
                               FontWeight="Bold"
                               Opacity="0.7"/>

                    <TextBlock Grid.Column="1"
                               Text="Tomas"
                               FontWeight="Bold"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>

                </Grid>

                <!-- Personas -->
                <ScrollViewer Grid.Row="1">

                    <ItemsControl ItemsSource="{Binding PersonasFiltradas}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Classes="table-button"
                                        Command="{Binding $parent[ItemsControl].DataContext.SeleccionarPersonaCommand}"
                                        CommandParameter="{Binding}">

                                    <Grid ColumnDefinitions="*,120">

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding NombreCompleto}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Tomas.Count}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </Button>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>
