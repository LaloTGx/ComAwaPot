<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ComAwaPot.Views.PersonasView">

    <StackPanel Spacing="12">

        <TextBlock Text="Personas"
                   FontSize="32"
                   FontWeight="Bold"/>

        <TextBlock Text="Aquí administraremos las personas registradas."
                   FontSize="16"
                   Opacity="0.7"/>

    </StackPanel>

</UserControl>
