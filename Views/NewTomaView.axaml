<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ComAwaPot.ViewModels"
             x:Class="ComAwaPot.Views.NewTomaView"
             x:DataType="vm:NewTomaViewModel">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="24">

        <StackPanel Grid.Row="0"
                    Spacing="4">

            <TextBlock Text="Nueva toma"
                       FontSize="32"
                       FontWeight="Bold"/>

            <TextBlock Text="Registra una nueva toma para esta persona."
                       FontSize="16"
                       Opacity="0.7"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="#18181B"
                CornerRadius="8"
                Padding="24"
                MaxWidth="700"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="*,*"
                  RowSpacing="16"
                  ColumnSpacing="16">

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Spacing="6">

                    <TextBlock Text="Número de contrato"/>

                    <TextBox Text="{Binding NumeroContrato}"
                             PlaceholderText="Número de contrato"/>

                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Spacing="6">

                    <TextBlock Text="Estado"/>

                    <ComboBox SelectedItem="{Binding Estado}"
                              ItemsSource="{Binding Source={x:Static vm:NewTomaViewModel.Estados}}"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Spacing="6">

                    <TextBlock Text="Calle"/>

                    <TextBox Text="{Binding Calle}"
                             PlaceholderText="Calle"/>

                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">

                    <TextBlock Text="Número exterior"/>

                    <TextBox Text="{Binding NumExt}"
                             PlaceholderText="Número exterior"/>

                </StackPanel>

                <Button Grid.Row="2"
                        Grid.Column="1"
                        Content="Guardar"
                        Command="{Binding GuardarCommand}"
                        HorizontalAlignment="Right"
                        Padding="18,10"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
